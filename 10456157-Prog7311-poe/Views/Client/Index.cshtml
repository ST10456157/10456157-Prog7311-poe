@model IEnumerable<_10456157_Prog7311_poe.Models.Client>

<h2>Clients</h2>

<a asp-action="Create">Add New Client</a>

<table>
    <tr>
        <th>Name</th>
        <th>Contact</th>
        <th>Region</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.ContactDetails</td>
            <td>@item.Region</td>
        </tr>
    }
</table>