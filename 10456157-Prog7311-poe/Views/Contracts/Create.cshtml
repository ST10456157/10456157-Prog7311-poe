@model _10456157_Prog7311_poe.Models.Contract

<h2>Create Contract</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div asp-validation-summary="All"></div>

    
    <div>
        <label>Client</label>
        <select asp-for="ClientId" asp-items="ViewBag.ClientId" class="form-control"></select>
        <span asp-validation-for="ClientId" class="text-danger"></span>
    </div>

    
    <div>
        <label>Start Date</label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    
    <div>
        <label>End Date</label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    
    <div>
        <label>Status</label>
        <select asp-for="Status" class="form-control">
            <option value="">-- Select Status --</option>
            <option>Draft</option>
            <option>Active</option>
            <option>Expired</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    
    <div>
        <label>Service Level</label>
        <select asp-for="ServiceLevel" class="form-control">
            <option value="">-- Select Service Level --</option>
            <option>Standard</option>
            <option>Express</option>
        </select>
        <span asp-validation-for="ServiceLevel" class="text-danger"></span>
    </div>

    
    <div>
        <label>Upload Contract (PDF)</label>
        <input type="file" name="file" class="form-control" />
        <span asp-validation-for="FilePath" class="text-danger"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Save</button>

</form>
