@model _10456157_Prog7311_poe.Models.Contract

<h2>Create Contract</h2>

<form asp-action="Create" enctype="multipart/form-data">

    <label>Client</label>
    <select asp-for="ClientId" asp-items="ViewBag.ClientId"></select>

    <label>Start Date</label>
    <input asp-for="StartDate" type="date" />

    <label>End Date</label>
    <input asp-for="EndDate" type="date" />

    <label>Status</label>
    <select asp-for="Status">
        <option>Draft</option>
        <option>Active</option>
        <option>Expired</option>
    </select>

    <label>Service Level</label>
    <select asp-for="ServiceLevel">
        <option>Standard</option>
        <option>Express</option>
    </select>

    <label>Upload Contract (PDF)</label>
    <input type="file" name="file" />

    <button type="submit">Save</button>

</form>
